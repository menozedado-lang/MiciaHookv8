local VoidCFrame = CFrame.new(9000, 9000, 9000)
local trackedParts = {}
local playerName = LocalPlayer.Name:lower()

local features = {
    VoidSpam = true,
    SlingBypass = true,
    DaggerBypass = true,
    AntiClose = true
}

--// Your Strong Projectile Tracking
workspace.ChildAdded:Connect(function(obj)
    if not obj:IsA("BasePart") and not obj:IsA("MeshPart") then return end
    if obj.Name == "CoreProjectile" then
        trackedParts[obj] = true
    elseif obj.Name == "Part" then
        task.defer(function()
            if obj and obj.Parent and obj.AssemblyLinearVelocity.Magnitude > 40 then
                trackedParts[obj] = true
            end
        end)
    end
end)

workspace.ChildRemoved:Connect(function(obj)
    trackedParts[obj] = nil
end)

--// STRONG VOID SPAM (Using your method + improvements)
local function strongVoid()
    if not features.VoidSpam then return end
    pcall(function()
        -- Void Enemy Players
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local root = plr.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    root.CFrame = VoidCFrame
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    root.Velocity = Vector3.zero
                end
                
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hum then hum.Health = 0 end
            end
        end

        -- Void Projectiles in workspace
        for _, obj in ipairs(workspace:GetChildren()) do
            if (obj:IsA("BasePart") or obj:IsA("MeshPart")) and obj.Name == "CoreProjectile" then
                obj.CFrame = VoidCFrame
                obj.AssemblyLinearVelocity = Vector3.zero
            end
        end

        -- Void Tracked Fast Projectiles
        for part in pairs(trackedParts) do
            if part and part.Parent then
                part.CFrame = VoidCFrame
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            else
                trackedParts[part] = nil
            end
        end
    end)
end

RunService.Heartbeat:Connect(strongVoid)

--// Reliable Auto Shoot (Especially for Sling)
local function autoShoot()
    pcall(function()
        local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if not tool then return end

        local toolName = tool.Name:lower()
        if not (toolName:find("sling") or toolName:find("dagger") or toolName:find("knife") 
                or toolName:find("blade") or toolName:find("throw")) then return end

        -- Force activate
        tool:Activate()

        -- Fire every possible remote
        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                local n = v.Name:lower()
                if n:find("shoot") or n:find("fire") or n:find("throw") or n:find("attack") 
                   or n:find("cast") or n:find("launch") then
                    pcall(function() v:FireServer() end)
                end
            end
        end
    end)
end

RunService.Heartbeat:Connect(autoShoot)

--// Improved Sling + Dagger Bypass
local function applyBypass()
    pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        setreadonly(mt, false)

        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" then
                local args = {...}
                local remoteName = self.Name:lower()
                local argStr = tostring(args[1] or ""):lower()

                -- SLING BYPASS (Stronger)
                if features.SlingBypass and (remoteName:find("sling") or remoteName:find("shoot") or argStr:find("sling")) then
                    if argStr:find(playerName) or argStr:find("owner") or argStr:find("self") or #args <= 3 then
                        return old(self, ...)  -- Allow your shots
                    else
                        return  -- Block anti-cheat checks
                    end
                end

                -- DAGGER BYPASS
                if features.DaggerBypass and (remoteName:find("dagger") or remoteName:find("knife") 
                    or remoteName:find("throw") or remoteName:find("blade")) then
                    if argStr:find(playerName) or argStr:find("owner") then
                        return old(self, ...)
                    else
                        return
                    end
                end
            end
            return old(self, ...)
        end)

        setreadonly(mt, true)
    end)
end

applyBypass()

--// Anti Close
local function antiClose()
    if not features.AntiClose then return end
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            if (hrp.Position - plr.Character.HumanoidRootPart.Position).Magnitude < 20 then
                hrp.CFrame = hrp.CFrame + hrp.CFrame.LookVector * 60 + Vector3.new(0, 30, 0)
                break
            end
        end
    end
end
RunService.Heartbeat:Connect(antiClose)

