    pillTxt.Parent             = pill

    -- knob inside pill
    local knob = Instance.new("Frame")
    knob.Size             = UDim2.fromOffset(22,22)
    knob.Position         = State[cfg.stateKey]
        and UDim2.fromOffset(38, 4)
        or  UDim2.fromOffset(4,  4)
    knob.BackgroundColor3 = Color3.new(1,1,1)
    knob.BorderSizePixel  = 0
    knob.Parent           = pill
    corner(knob, 11)

    -- invisible hit button over whole card
    local hitBtn = Instance.new("TextButton")
    hitBtn.Size               = UDim2.fromScale(1,1)
    hitBtn.BackgroundTransparency = 1
    hitBtn.Text               = ""
    hitBtn.ZIndex             = 5
    hitBtn.Parent             = card

    local function refresh()
        local on = State[cfg.stateKey]
        tween(pill,  {BackgroundColor3 = on and PAL.on or PAL.off}, 0.15)
        tween(knob,  {Position = on
            and UDim2.fromOffset(38,4)
            or  UDim2.fromOffset(4, 4)}, 0.15)
        pillTxt.Text = on and "ON" or "OFF"
        -- subtle card border flash
        tween(card, {}, 0.05)
    end

    hitBtn.MouseButton1Click:Connect(function()
        State[cfg.stateKey] = not State[cfg.stateKey]
        refresh()
        if cfg.onToggle then cfg.onToggle(State[cfg.stateKey]) end
        -- bounce animation on icon circle
        tween(iconCircle, {BackgroundColor3 = PAL.accentHi}, 0.08)
        task.delay(0.12, function()
            tween(iconCircle, {BackgroundColor3 = PAL.accent}, 0.12)
        end)
    end)

    -- hover highlight
    hitBtn.MouseEnter:Connect(function()
        tween(card, {BackgroundColor3 = Color3.fromRGB(50,36,84)}, 0.12)
    end)
    hitBtn.MouseLeave:Connect(function()
        tween(card, {BackgroundColor3 = PAL.panel}, 0.12)
    end)

    return card
end

-- ── whirl button (not a toggle — it's an action button) ──────
local function makeWhirlButton()
    local card = Instance.new("Frame")
    card.LayoutOrder        = 5
    card.Size               = UDim2.new(1, 0, 0, 70)
    card.BackgroundColor3   = PAL.panel
    card.BorderSizePixel    = 0
    card.Parent             = Scroll
    corner(card, 14)
    stroke(card, PAL.whirl, 1.5)

    local iconCircle = Instance.new("Frame")
    iconCircle.Size             = UDim2.fromOffset(44, 44)
    iconCircle.Position         = UDim2.fromOffset(12, 13)
    iconCircle.BackgroundColor3 = PAL.whirl
    iconCircle.BorderSizePixel  = 0
    iconCircle.Parent           = card
    corner(iconCircle, 12)

    local iconLbl = Instance.new("TextLabel")
    iconLbl.Size               = UDim2.fromScale(1,1)
    iconLbl.BackgroundTransparency = 1
    iconLbl.Text               = "🌀"
    iconLbl.TextColor3         = Color3.new(1,1,1)
    iconLbl.Font               = Enum.Font.GothamBold
    iconLbl.TextSize            = 22
    iconLbl.Parent             = iconCircle

    local titleLbl = label(card, "WHIRL ORBIT", 16, PAL.text, Enum.Font.GothamBold)
    titleLbl.Size     = UDim2.new(1,-130,0,20)
    titleLbl.Position = UDim2.fromOffset(66,14)

    local subLbl = label(card, "Orbit + fling nearest enemy  |  X to stop", 12, PAL.subtext, Enum.Font.Gotham)
    subLbl.Size     = UDim2.new(1,-130,0,16)
    subLbl.Position = UDim2.fromOffset(66,36)
    subLbl.TextWrapped = true

    local actionBtn = Instance.new("Frame")
    actionBtn.Size             = UDim2.fromOffset(64,30)
    actionBtn.Position         = UDim2.new(1,-76,0.5,-15)
    actionBtn.BackgroundColor3 = PAL.whirlOff
    actionBtn.BorderSizePixel  = 0
    actionBtn.Parent           = card
    corner(actionBtn, 10)

    local actionTxt = Instance.new("TextLabel")
    actionTxt.Size               = UDim2.fromScale(1,1)
    actionTxt.BackgroundTransparency = 1
    actionTxt.Text               = "START"
    actionTxt.TextColor3         = Color3.new(1,1,1)
    actionTxt.Font               = Enum.Font.GothamBold
    actionTxt.TextSize           = 13
    actionTxt.Parent             = actionBtn

    local hitBtn = Instance.new("TextButton")
    hitBtn.Size               = UDim2.fromScale(1,1)
    hitBtn.BackgroundTransparency = 1
    hitBtn.Text               = ""
    hitBtn.ZIndex             = 5
    hitBtn.Parent             = card

    local function refreshWhirlBtn()
        if State.Whirl then
            tween(actionBtn, {BackgroundColor3 = PAL.whirl}, 0.15)
            actionTxt.Text = "STOP"
            tween(stroke(card, PAL.whirl, 2), {}, 0)
        else
            tween(actionBtn, {BackgroundColor3 = PAL.whirlOff}, 0.15)
            actionTxt.Text = "START"
        end
    end

    hitBtn.MouseButton1Click:Connect(function()
        if State.Whirl then
            stopWhirl()
        else
            startWhirl()
        end
        refreshWhirlBtn()
        tween(iconCircle, {BackgroundColor3 = Color3.fromRGB(255,160,220)}, 0.08)
        task.delay(0.14, function()
            tween(iconCircle, {BackgroundColor3 = PAL.whirl}, 0.14)
        end)
    end)

    hitBtn.MouseEnter:Connect(function()
        tween(card, {BackgroundColor3 = Color3.fromRGB(55,30,60)}, 0.12)
    end)
    hitBtn.MouseLeave:Connect(function()
        tween(card, {BackgroundColor3 = PAL.panel}, 0.12)
    end)

    -- keep button state in sync when whirl stops externally
    RunService.Heartbeat:Connect(function()
        if not State.Whirl and actionTxt.Text == "STOP" then
            refreshWhirlBtn()
        end
    end)
end

