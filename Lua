-- ═══════════════════════════════════════════
-- ORBIT RAGEBOT
-- Aura orbits around target HEAD (not HRP)
-- ═══════════════════════════════════════════
local orbitConn     = nil
local orbitLastShot = 0
local orbitLastTP   = 0
local orbitAngle    = 0

local function getSmartOrbitParams(target)
    if not Config.OrbitSmartMode then return Config.OrbitSpeed, Config.OrbitRadius end
    local weapon = getPlayerWeapon(target):lower()
    if     weapon:find("sniper")  then return 80,  12
    elseif weapon:find("shotgun") then return 120, 15
    elseif weapon:find("melee")
        or weapon:find("sword")
        or weapon:find("dagger")
        or weapon:find("knife")   then return 60,  6
    elseif weapon:find("sling")   then return 90,  10
    elseif weapon:find("bow")     then return 70,  11
    else return Config.OrbitSpeed, Config.OrbitRadius
    end
end

local function hasRiotShield(p)
    local chr = p and p.Character
    if not chr then return false end
    for _, obj in ipairs(chr:GetChildren()) do
        if obj:IsA("Tool") and
           (obj.Name:lower():find("riot") or obj.Name:lower():find("shield")) then
            return true
        end
    end
    return false
end

local function detectIncomingProjectile()
    local myChar = LP.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return false end
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("BasePart") and obj.Name == "CoreProjectile" then
            local vel = obj.AssemblyLinearVelocity
            if vel.Magnitude > 50 then
                local toMe = myHRP.Position - obj.Position
                if toMe.Unit:Dot(vel.Unit) > 0.7 and toMe.Magnitude < 30 then
                    return true
                end
            end
        end
    end
    return false
end

local function stopOrbitRagebot()
    if orbitConn then orbitConn:Disconnect() orbitConn = nil end
end

local function startOrbitRagebot()
    stopOrbitRagebot()
    orbitAngle = 0

    orbitConn = RunService.Heartbeat:Connect(function(dt)
        local myChar = LP.Character
        local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end

        local target    = getNearestEnemy()
        if not target   then return end
        local targetChr = target.Character
        if not targetChr then return end

        local targetHRP  = targetChr:FindFirstChild("HumanoidRootPart")
        if not targetHRP then return end

        -- Use Head for aura orbit center if it exists, else fall back to HRP
        local targetHead = targetChr:FindFirstChild("Head")
        local auraCenter = targetHead and targetHead.Position or targetHRP.Position

        if Config.OrbitAntiRiot and hasRiotShield(target) then
            orbitAngle = orbitAngle + 180
        end

        local speed, radius = getSmartOrbitParams(target)

        if Config.OrbitAntiProjectile and detectIncomingProjectile() then
            orbitAngle = orbitAngle + 90
        end

        orbitAngle = (orbitAngle + speed * dt) % 360
        local rad      = math.rad(orbitAngle)
        -- Orbit horizontally around the head position
        local orbitPos = auraCenter + Vector3.new(
            math.cos(rad) * radius,
            0,
            math.sin(rad) * radius
        )

        local now = tick()
        if now - orbitLastTP < Config.OrbitTPDelay then return end
        orbitLastTP = now

        if Config.OrbitResolver then
            orbitAngle = orbitAngle + math.random(-15, 15)
        end

        myHRP.CFrame = CFrame.new(orbitPos)
        myHRP.AssemblyLinearVelocity = Vector3.zero

        -- Aura: orbit an additional part around the TARGET HEAD
        if Config.OrbitAura then
            -- Teleport target HRP to a position that circles the head Y level
            local auraAngle = math.rad((orbitAngle + 180) % 360)
            local auraPos   = auraCenter + Vector3.new(
                math.cos(auraAngle) * (radius * 0.5),
                0,
                math.sin(auraAngle) * (radius * 0.5)
            )
            targetHRP.CFrame = CFrame.new(auraPos.X, auraCenter.Y, auraPos.Z)
            targetHRP.AssemblyLinearVelocity  = Vector3.zero
            targetHRP.AssemblyAngularVelocity = Vector3.zero
        end

        if Config.OrbitStrikeOnMelee then
            local weapon = getPlayerWeapon(target):lower()
            if (weapon:find("melee") or weapon:find("sword") or
                weapon:find("dagger") or weapon:find("knife")) and
               (myHRP.Position - targetHRP.Position).Magnitude < 10 then
                myHRP.CFrame = CFrame.new(targetHRP.Position + Vector3.new(0, 0, 2))
                task.wait(0.05)
                pcall(function()
                    local tool = myChar:FindFirstChildOfClass("Tool")
                    if tool then
                        local r = tool:FindFirstChild("RemoteEvent")
                        if r then r:FireServer() end
                    end
                end)
            end
        end

        if now - orbitLastShot >= Config.OrbitShotInterval then
            orbitLastShot = now
            pcall(function()
                local tool = myChar:FindFirstChildOfClass("Tool")
                if tool then
                    local r = tool:FindFirstChild("RemoteEvent")
                    if r then r:FireServer() end
                end
            end)
        end
    end)
end

-- ═══════════════════════════════════════════
-- VOID SPAM RAGEBOT
-- ═══════════════════════════════════════════
local voidSpamConn = nil

local function stopVoidSpam()
    if voidSpamConn then voidSpamConn:Disconnect() voidSpamConn = nil end
    Config.VoidSpamRunning = false
end

local function voidSpamCycle(target)
    if Config.VoidSpamRunning then return end
    Config.VoidSpamRunning = true
    local myChar = LP.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then Config.VoidSpamRunning = false return end
    local originalCF = myHRP.CFrame
    local underVoid  = CFrame.new(0, Config.VoidSpamVoidY, 0)
    myHRP.CFrame = underVoid
    myHRP.AssemblyLinearVelocity = Vector3.zero
    task.wait(Config.VoidSpamHide)
    local targetChr = target and target.Character
    local targetHRP = targetChr and targetChr:FindFirstChild("HumanoidRootPart")
    if targetHRP then
        myHRP.CFrame = CFrame.new(targetHRP.Position + Vector3.new(0, 3, 0))
        myHRP.AssemblyLinearVelocity = Vector3.zero
        for i = 1, Config.VoidSpamShots do
            pcall(function()
                local tool = myChar:FindFirstChildOfClass("Tool")
                if tool then
                    local r = tool:FindFirstChild("RemoteEvent")
                    if r then r:FireServer() end
                    local a = tool:FindFirstChild("Activate")
                    if a and a:IsA("RemoteEvent") then a:FireServer() end
                end
            end)
            if i < Config.VoidSpamShots then task.wait(0.05) end
        end
        task.wait(Config.VoidSpamAttack)
    end
    myHRP.CFrame = underVoid
    myHRP.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.08)
    myHRP.CFrame = originalCF
    myHRP.AssemblyLinearVelocity = Vector3.zero
    Config.VoidSpamRunning = false
end

local function startVoidSpam()
    stopVoidSpam()
    voidSpamConn = RunService.Heartbeat:Connect(function()
        if Config.VoidSpamRunning then return end
        local target = getPriorityTarget()
        if not target then return end
        task.spawn(function() voidSpamCycle(target) end)
    end)
end

