-- ── Safe library loader with retry ──
local function safeLoad(url, name)
    local attempts = 0
    local maxAttempts = 3
    while attempts < maxAttempts do
        attempts = attempts + 1
        local ok, result = pcall(function()
            return loadstring(game:HttpGet(url, true))()
        end)
        if ok and result then
            return result
        end
        warn("[yux/overkill] Failed to load " .. name .. " (attempt " .. attempts .. "): " .. tostring(result))
        task.wait(1)
    end
    return nil
end

