local VOID_CF          = CFrame.new(9e3, 9e3, 9e3)
local VOID_V3          = Vector3.new(9e3, 9e3, 9e3)
local ZERO_V3          = Vector3.zero
local INF_V3           = Vector3.new(1/0, 1/0, 1/0)
local PROJ_SPEED_THRESH = 40
local ANTI_CLOSE_DIST  = 20
local ANTI_CLOSE_PUSH  = 60
local WHIRL_RADIUS     = 1.2
local WHIRL_SPEED_DEG  = 100  -- degrees per RenderStepped

