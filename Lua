-- BYPASS (All weapons)
-- ═══════════════════════════════════════════
local bypTracked  = {}
local bypHB       = nil
local bypChildAdd = nil
local bypChildRem = nil
local bypDescAdd  = nil

local function isKnownProjectile(name)
    for _,n in ipairs(Config.ExtraProjectileNames) do
        if name==n then return true end
    end
    return false
end

local function isFastPart(part)
    return part:IsA("BasePart") and
           part.AssemblyLinearVelocity.Magnitude > Config.SpeedThreshold
end

local function bypTrack(obj)
    if not obj:IsA("BasePart") then return end
    bypTracked[obj]=true
end

local function stopBypass()
    if bypHB       then bypHB:Disconnect()       bypHB=nil       end
    if bypChildAdd then bypChildAdd:Disconnect()  bypChildAdd=nil end
    if bypChildRem then bypChildRem:Disconnect()  bypChildRem=nil end
    if bypDescAdd  then bypDescAdd:Disconnect()   bypDescAdd=nil  end
    bypTracked            = {}
    predCache             = {}
    nearestEnemyCache     = nil
    nearestEnemyCacheTime = 0
    cleanupPredSphere()
end

local function startBypass()
    stopBypass()

    bypChildAdd = workspace.ChildAdded:Connect(function(o)
        if not o:IsA("BasePart") then return end
        if isKnownProjectile(o.Name) then bypTrack(o) return end
        task.defer(function()
            if o and o.Parent then
                if isFastPart(o) then bypTrack(o)
                elseif o:IsA("Model") or o:IsA("Folder") then
                    for _,child in ipairs(o:GetDescendants()) do
                        if child:IsA("BasePart") and (isKnownProjectile(child.Name) or isFastPart(child)) then
                            bypTrack(child)
                        end
                    end
                end
            end
        end)
    end)

    bypDescAdd = workspace.DescendantAdded:Connect(function(o)
        if not o:IsA("BasePart") then return end
        if isKnownProjectile(o.Name) then bypTrack(o) end
    end)

    bypChildRem = workspace.ChildRemoved:Connect(function(o)
        bypTracked[o]=nil
        if o:IsA("Model") or o:IsA("Folder") then
            for _,child in ipairs(o:GetDescendants()) do
                bypTracked[child]=nil
            end
        end
    end)

    bypHB = RunService.Heartbeat:Connect(function()
        pcall(function()
            frameCount=frameCount+1

            if Config.PredictionEnabled and frameCount%PRED_UPDATE_RATE==0 then
                for _,p in ipairs(playerCache) do
                    local hrp=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then updatePredCacheForPlayer(p,hrp) end
                end
            end

            local nearestOnly = Config.TargetMode=="Nearest Enemy" and getNearestEnemy() or nil

            if Config.PredictionEnabled and Config.PredictionShowSphere and frameCount%3==0 then
                local pt=nearestOnly
                    or (Config.TargetMode=="Specific Player" and targetPlayerObj)
                    or nearestEnemyCache
                if pt then updatePredSphere(getPredictedPosition(pt)) end
            elseif not Config.PredictionEnabled then
                cleanupPredSphere()
            end

            if Config.TeleportEnemies then
                local vx,vy,vz=Config.VoidPos.X,Config.VoidPos.Y,Config.VoidPos.Z
                for _,p in ipairs(playerCache) do
                    if not shouldTargetPlayer(p) then continue end
                    local skip=false
                    if Config.TargetMode=="Nearest Enemy" then skip=p~=nearestOnly
                    elseif Config.TargetMode=="Specific Player" then skip=p~=targetPlayerObj end
                    if not skip and p.Character then
                        local h=p.Character:FindFirstChild("HumanoidRootPart")
                        if h then
                            if Config.PredictionEnabled then
                                local pred=getPredictedPosition(p)
                                h.CFrame=pred and CFrame.new(pred.X,vy,pred.Z) or CFrame.new(vx,vy,vz)
                            else
                                h.CFrame=CFrame.new(vx,vy,vz)
                            end
                            h.AssemblyLinearVelocity=Vector3.zero
                            h.AssemblyAngularVelocity=Vector3.zero
                        end
                    end
                end
            end

            if Config.VoidProjectiles then
                local vcf=CFrame.new(Config.VoidPos)
                for part in pairs(bypTracked) do
                    if part and part.Parent then
                        part.CFrame=vcf
                        part.AssemblyLinearVelocity=Vector3.zero
                    else
                        bypTracked[part]=nil
                    end
                end
                for _,obj in ipairs(workspace:GetChildren()) do
                    if obj:IsA("BasePart") then
                        if isKnownProjectile(obj.Name)
                           or obj.AssemblyLinearVelocity.Magnitude>Config.SpeedThreshold then
                            obj.CFrame=vcf
                            obj.AssemblyLinearVelocity=Vector3.zero
                            bypTracked[obj]=true
                        end
                    end
                end
            end
        end)
    end)
end

