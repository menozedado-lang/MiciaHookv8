-- ═══════════════════════════════════════════
-- PREDICTION CACHE (used by bypass to lead void)
-- ═══════════════════════════════════════════
local predCache    = {}
local HISTORY_SIZE = 5

local function initPredCache(p)
    predCache[p] = {
        pos     = Vector3.zero,
        vel     = Vector3.zero,
        accel   = Vector3.zero,
        smoothed = nil,
        history  = {},
    }
end

local function updatePredCacheForPlayer(p, hrp)
    local now = tick()
    local pos = hrp.Position
    if not predCache[p] then initPredCache(p) end
    local c = predCache[p]
    local h = c.history
    h[#h+1] = {pos=pos, t=now}
    if #h > HISTORY_SIZE then table.remove(h, 1) end
    if #h >= 2 then
        local dt = h[#h].t - h[1].t
        if dt > 0 then
            c.vel = (h[#h].pos - h[1].pos) / dt * 0.65
                  + hrp.AssemblyLinearVelocity * 0.35
        end
    else
        c.vel = hrp.AssemblyLinearVelocity
    end
    if #h >= 3 then
        local n   = #h
        local dt1 = h[n].t   - h[n-1].t
        local dt2 = h[n-1].t - h[n-2].t
        if dt1 > 0 and dt2 > 0 then
            c.accel = ((h[n].pos - h[n-1].pos)/dt1
                    -  (h[n-1].pos - h[n-2].pos)/dt2)
                    / ((dt1 + dt2) * 0.5)
        end
    end
    c.pos = pos
end

-- ═══════════════════════════════════════════
-- PREDICTION: LOCAL PLAYER GOES TO VOID
-- Sends LP's HumanoidRootPart to the void
-- based on predicted enemy positions so LP
-- appears to be at the enemy location
-- ═══════════════════════════════════════════
local predVoidConn = nil

local function stopPredVoid()
    if predVoidConn then predVoidConn:Disconnect() predVoidConn = nil end
end

local function startPredVoid()
    stopPredVoid()
    predVoidConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            local myChar = LP.Character
            local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if not myHRP then return end

            -- Update prediction cache for all enemies
            for _, p in ipairs(playerCache) do
                local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then updatePredCacheForPlayer(p, hrp) end
            end

            -- Get nearest enemy prediction
            local target = getNearestEnemy()
            if not target then
                -- No target: send LP to void
                myHRP.CFrame = CFrame.new(Config.VoidPos)
                myHRP.AssemblyLinearVelocity  = Vector3.zero
                myHRP.AssemblyAngularVelocity = Vector3.zero
                return
            end

            local c = predCache[target]
            if not c then
                myHRP.CFrame = CFrame.new(Config.VoidPos)
                myHRP.AssemblyLinearVelocity  = Vector3.zero
                myHRP.AssemblyAngularVelocity = Vector3.zero
                return
            end

            -- Calculate lead time
            local tl = Config.PredictionStrength + Config.PredictionLatency
            if Config.PredictionAdaptive then
                local sc = math.clamp(1 - c.vel.Magnitude / 200, 0.4, 1.4)
                tl = tl * sc
            end

            -- Calculate predicted position
            local pred
            if Config.PredictionMethod == "Velocity Only" then
                pred = c.pos + c.vel * tl
            elseif Config.PredictionMethod == "Velocity + Accel" then
                pred = c.pos + c.vel * tl + c.accel * (0.5 * tl * tl)
            else
                pred = c.pos + c.vel * tl + c.accel * 0.5 * (0.5 * tl * tl)
            end

            -- Clamp max lead
            local delta = pred - c.pos
            local mag   = delta.Magnitude
            if mag > Config.PredictionMaxLead then
                pred = c.pos + delta * (Config.PredictionMaxLead / mag)
            end

            -- Smooth
            local sf = Config.PredictionSmoothFactor
            if sf > 0 then
                c.smoothed = c.smoothed and c.smoothed * sf + pred * (1 - sf) or pred
                pred = c.smoothed
            end

            -- Send LOCAL PLAYER to void at the predicted enemy X/Z
            -- Y stays at void height so LP is invisible/underground
            local vy = Config.VoidPos.Y
            myHRP.CFrame = CFrame.new(pred.X, vy, pred.Z)
            myHRP.AssemblyLinearVelocity  = Vector3.zero
            myHRP.AssemblyAngularVelocity = Vector3.zero
        end)
    end)
end

-- ═══════════════════════════════════════════
-- PROJECTILE TAB LOGIC
-- Only tracks "CoreProjectile" by name
-- Actually teleports the part to void (real CFrame move)
-- ═══════════════════════════════════════════
local projTracked  = {}
local projChildAdd = nil
local projChildRem = nil
local projDescAdd  = nil
local projHB       = nil

local function projTrack(obj)
    if not obj:IsA("BasePart") then return end
    if obj.Name ~= "CoreProjectile" then return end
    projTracked[obj] = true
end

local function stopProjectile()
    if projHB       then projHB:Disconnect()       projHB       = nil end
    if projChildAdd then projChildAdd:Disconnect()  projChildAdd = nil end
    if projChildRem then projChildRem:Disconnect()  projChildRem = nil end
    if projDescAdd  then projDescAdd:Disconnect()   projDescAdd  = nil end
    projTracked = {}
end

local function startProjectile()
    stopProjectile()

    -- Watch workspace top-level children
    projChildAdd = workspace.ChildAdded:Connect(function(o)
        if o.Name == "CoreProjectile" and o:IsA("BasePart") then
            projTrack(o)
        end
    end)

    -- Watch all descendants (in case it parents inside a model)
    projDescAdd = workspace.DescendantAdded:Connect(function(o)
        if o.Name == "CoreProjectile" and o:IsA("BasePart") then
            projTrack(o)
        end
    end)

    projChildRem = workspace.ChildRemoved:Connect(function(o)
        projTracked[o] = nil
    end)

    -- Scan existing workspace for any already-existing CoreProjectile
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "CoreProjectile" and obj:IsA("BasePart") then
            projTracked[obj] = true
        end
    end

    local vcf = CFrame.new(Config.ProjectileVoidPos)

    projHB = RunService.Heartbeat:Connect(function()
        pcall(function()
            -- Update void CFrame in case slider changed
            vcf = CFrame.new(Config.ProjectileVoidPos)
            for part in pairs(projTracked) do
                if part and part.Parent then
                    -- Actual teleport: set real CFrame position
                    part.CFrame = vcf
                    part.AssemblyLinearVelocity  = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                else
                    projTracked[part] = nil
                end
            end
        end)
    end)
end

