local function createBtn(text, yPos, key, icon)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.92,0,0,50)
    btn.Position = UDim2.new(0.04,0,0,yPos)
    btn.BackgroundColor3 = features[key] and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(45,45,55)
    btn.Text = "   "..icon.."  "..text..": " .. (features[key] and "ON" or "OFF")
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 17
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = MainFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,10)

    btn.MouseButton1Click:Connect(function()
        features[key] = not features[key]
        if features[key] then
            btn.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
            btn.Text = "   "..icon.."  "..text..": ON"
        else
            btn.BackgroundColor3 = Color3.fromRGB(45,45,55)
            btn.Text = "   "..icon.."  "..text..": OFF"
        end
    end)
end

