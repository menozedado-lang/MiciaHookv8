-- ────────────────────────────────────────────────────────────
--  UTILITY
-- ────────────────────────────────────────────────────────────
local function safeCall(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[voidgod] pcall failed: " .. tostring(err))
    end
end

local function notify(title, text, duration)
    safeCall(function()
        StarterGui:SetCore("SendNotification", {
            Title    = title,
            Text     = text,
            Duration = duration or 4,
        })
    end)
end

local function getLpChar()
    local char = LP.Character
    if not char then return nil, nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    return char, hrp
end

local function getHum(char)
    return char and char:FindFirstChildOfClass("Humanoid")
end

-- Returns the nearest enemy Player or nil
local function getNearestEnemy()
    local _, myHRP = getLpChar()
    if not myHRP then return nil end
    local myPos   = myHRP.Position
    local best, bestDSq = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local chr = p.Character
            local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dSq = (hrp.Position - myPos).Magnitude ^ 2
                if dSq < bestDSq then bestDSq = dSq best = p end
            end
        end
    end
    return best
end

-- ────────────────────────────────────────────────────────────
--  PROJECTILE TRACKER
-- ────────────────────────────────────────────────────────────
local function onChildAdded(obj)
    if not (obj:IsA("BasePart") or obj:IsA("MeshPart")) then return end
    if obj.Name == "CoreProjectile" then
        State.trackedParts[obj] = true
    elseif obj.Name == "Part" then
        task.defer(function()
            if obj and obj.Parent
               and obj.AssemblyLinearVelocity.Magnitude > PROJ_SPEED_THRESH then
                State.trackedParts[obj] = true
            end
        end)
    end
end

local function onChildRemoved(obj)
    State.trackedParts[obj] = nil
end

workspace.ChildAdded:Connect(onChildAdded)
workspace.ChildRemoved:Connect(onChildRemoved)

-- ────────────────────────────────────────────────────────────
--  VOID SPAM
-- ────────────────────────────────────────────────────────────
local function tickVoidSpam()
    if not State.VoidSpam then return end
    safeCall(function()
        -- void enemy players
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local chr = p.Character
                if chr then
                    local hrp = chr:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = VOID_CF
                        hrp.AssemblyLinearVelocity  = ZERO_V3
                        hrp.AssemblyAngularVelocity = ZERO_V3
                    end
                end
            end
        end

        -- void CoreProjectile children of workspace
        for _, obj in ipairs(workspace:GetChildren()) do
            if (obj:IsA("BasePart") or obj:IsA("MeshPart"))
               and obj.Name == "CoreProjectile" then
                obj.CFrame = VOID_CF
                obj.AssemblyLinearVelocity = ZERO_V3
            end
        end

        -- void tracked fast parts
        for part in pairs(State.trackedParts) do
            if part and part.Parent then
                part.CFrame = VOID_CF
                part.AssemblyLinearVelocity  = ZERO_V3
                part.AssemblyAngularVelocity = ZERO_V3
            else
                State.trackedParts[part] = nil
            end
        end
    end)
end

-- ────────────────────────────────────────────────────────────
--  AUTO SHOOT  (sling / dagger / throw weapons)
-- ────────────────────────────────────────────────────────────
local SHOOT_NAMES = {
    "shoot", "fire", "throw", "attack", "cast", "launch"
}

local function tickAutoShoot()
    safeCall(function()
        local char = LP.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if not tool then return end

        local tn = tool.Name:lower()
        if not (tn:find("sling") or tn:find("dagger") or tn:find("knife")
             or tn:find("blade") or tn:find("throw")) then return end

        tool:Activate()

        for _, v in ipairs(tool:GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                local n = v.Name:lower()
                for _, kw in ipairs(SHOOT_NAMES) do
                    if n:find(kw) then
                        safeCall(function() v:FireServer() end)
                        break
                    end
                end
            end
        end
    end)
end

-- ────────────────────────────────────────────────────────────
--  ANTI CLOSE
-- ────────────────────────────────────────────────────────────
local function tickAntiClose()
    if not State.AntiClose then return end
    safeCall(function()
        local char, hrp = getLpChar()
        if not hrp then return end
        local myPos = hrp.Position
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local ehr = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if ehr and (ehr.Position - myPos).Magnitude < ANTI_CLOSE_DIST then
                    hrp.CFrame = hrp.CFrame
                        + hrp.CFrame.LookVector * ANTI_CLOSE_PUSH
                        + Vector3.new(0, 30, 0)
                    break
                end
            end
        end
    end)
end

-- ────────────────────────────────────────────────────────────
--  METATBLE BYPASS  (sling + dagger remote filter)
-- ────────────────────────────────────────────────────────────
local function applyMetatableBypass()
    if State.bypassHooked then return end
    safeCall(function()
        local mt  = getrawmetatable(game)
        local old = mt.__namecall
        setreadonly(mt, false)

        local lpName = LP.Name:lower()

        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" then
                local args = {...}
                local rn   = self.Name:lower()
                local a1   = tostring(args[1] or ""):lower()

                if State.SlingBypass
                   and (rn:find("sling") or rn:find("shoot") or a1:find("sling")) then
                    if a1:find(lpName) or a1:find("owner") or a1:find("self") or #args <= 3 then
                        return old(self, ...)
                    end
                    return
                end

                if State.DaggerBypass
                   and (rn:find("dagger") or rn:find("knife")
                     or rn:find("throw")  or rn:find("blade")) then
                    if a1:find(lpName) or a1:find("owner") then
                        return old(self, ...)
                    end
                    return
                end
            end
            return old(self, ...)
        end)

        setreadonly(mt, true)
        State.bypassHooked = true
    end)
end

-- ────────────────────────────────────────────────────────────
--  WHIRL (orbit + fling closest enemy)
-- ────────────────────────────────────────────────────────────
local function stopWhirl()
    State.Whirl = false
    if State.whirlConn then
        State.whirlConn:Disconnect()
        State.whirlConn = nil
    end
    safeCall(function()
        if State.whirlBV and State.whirlBV.Parent then State.whirlBV:Destroy() end
        if State.whirlBG and State.whirlBG.Parent then State.whirlBG:Destroy() end
    end)
    State.whirlBV     = nil
    State.whirlBG     = nil
    State.whirlTarget = nil
    State.whirlAngle  = 0

    safeCall(function()
        local char = LP.Character
        local hum  = getHum(char)
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated,     true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Climbing,    true)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping,     true)
            hum.PlatformStand = false
        end
        Camera.CameraSubject = hum
    end)
end

local function startWhirl()
    local target = getNearestEnemy()
    if not target then
        notify("Whirl", "No target found", 3)
        return
    end

    local char, hrp = getLpChar()
    local hum       = getHum(char)
    if not hrp or not hum then return end

    -- wait for target char
    local tChar = target.Character
    local deadline = tick() + 3
    while not (tChar and tChar:FindFirstChild("HumanoidRootPart")
                      and tChar:FindFirstChild("Head")) do
        if tick() > deadline then
            notify("Whirl", "Target character not ready", 3)
            return
        end
        task.wait()
        tChar = target.Character
    end

    -- disable humanoid states
    hum:SetStateEnabled(Enum.HumanoidStateType.Seated,     false)
    hum:SetStateEnabled(Enum.HumanoidStateType.Climbing,   false)
    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)
    hum:SetStateEnabled(Enum.HumanoidStateType.Jumping,    false)
    hum.PlatformStand = true

    -- create physics objects
    local bv = Instance.new("BodyVelocity")
    bv.Velocity  = ZERO_V3
    bv.MaxForce  = INF_V3
    bv.Parent    = hrp

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = INF_V3
    bg.Parent    = hrp

    State.whirlBV     = bv
    State.whirlBG     = bg
    State.whirlTarget = target
    State.Whirl       = true
    State.whirlAngle  = 0

    State.whirlConn = RunService.RenderStepped:Connect(function()
        local tChr  = State.whirlTarget and State.whirlTarget.Character
        local tRoot = tChr and tChr:FindFirstChild("HumanoidRootPart")
        local tHead = tChr and tChr:FindFirstChild("Head")
        local tHum  = tChr and tChr:FindFirstChildOfClass("Humanoid")

        if not tRoot or not tHum or tHum.Health <= 0 then
            stopWhirl()
            return
        end

        State.whirlAngle = State.whirlAngle + math.rad(WHIRL_SPEED_DEG)

        local cx = math.cos(State.whirlAngle) * WHIRL_RADIUS
        local cz = math.sin(State.whirlAngle) * WHIRL_RADIUS

        local dest = Vector3.new(
            tRoot.Position.X + cx,
            tRoot.Position.Y,
            tRoot.Position.Z + cz
        )

        hrp.CFrame = CFrame.new(dest) * CFrame.Angles(0, State.whirlAngle, 0)
        hrp.AssemblyLinearVelocity  = ZERO_V3
        hrp.AssemblyAngularVelocity = ZERO_V3

        if tHead then
            Camera.CameraSubject = tHead
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, tHead.Position)
            bg.CFrame = CFrame.lookAt(hrp.Position, tHead.Position)
        end

        -- fling velocity
        bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
    end)

    notify("Whirl", "Target: " .. target.Name .. "  |  X to stop", 5)
end

