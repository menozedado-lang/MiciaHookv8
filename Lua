-- ═══════════════════════════════════════════
-- PREDICTION
-- ═══════════════════════════════════════════
local predCache    = {}
local HISTORY_SIZE = 5
local predSphere   = nil

local function initPredCache(p)
    predCache[p]={pos=Vector3.zero,vel=Vector3.zero,accel=Vector3.zero,smoothed=nil,history={}}
end

local function updatePredCacheForPlayer(p,hrp)
    local now=tick() local pos=hrp.Position
    if not predCache[p] then initPredCache(p) end
    local c=predCache[p] local h=c.history
    h[#h+1]={pos=pos,t=now}
    if #h>HISTORY_SIZE then table.remove(h,1) end
    if #h>=2 then
        local dt=h[#h].t-h[1].t
        if dt>0 then c.vel=(h[#h].pos-h[1].pos)/dt*0.65+hrp.AssemblyLinearVelocity*0.35 end
    else c.vel=hrp.AssemblyLinearVelocity end
    if #h>=3 then
        local n=#h local dt1=h[n].t-h[n-1].t local dt2=h[n-1].t-h[n-2].t
        if dt1>0 and dt2>0 then
            c.accel=((h[n].pos-h[n-1].pos)/dt1-(h[n-1].pos-h[n-2].pos)/dt2)/((dt1+dt2)*0.5)
        end
    end
    c.pos=pos
end

local function getPredictedPosition(p)
    local c=predCache[p] if not c then return nil end
    local tl=Config.PredictionStrength+Config.PredictionLatency
    if Config.PredictionAdaptive then
        local sc=math.clamp(1-c.vel.Magnitude/200,0.4,1.4) tl=tl*sc
    end
    local pred
    if Config.PredictionMethod=="Velocity Only" then pred=c.pos+c.vel*tl
    elseif Config.PredictionMethod=="Velocity + Accel" then pred=c.pos+c.vel*tl+c.accel*(0.5*tl*tl)
    else pred=c.pos+c.vel*tl+c.accel*0.5*(0.5*tl*tl) end
    local delta=pred-c.pos local mag=delta.Magnitude
    if mag>Config.PredictionMaxLead then pred=c.pos+delta*(Config.PredictionMaxLead/mag) end
    local sf=Config.PredictionSmoothFactor
    if sf>0 then
        c.smoothed=c.smoothed and c.smoothed*sf+pred*(1-sf) or pred
        pred=c.smoothed
    end
    return pred
end

local function updatePredSphere(pos)
    if not Config.PredictionShowSphere then
        if predSphere then predSphere:Destroy() predSphere=nil end return
    end
    if not predSphere then
        predSphere=Instance.new("Part") predSphere.Name="PredSphere"
        predSphere.Shape=Enum.PartType.Ball predSphere.Size=Vector3.new(2,2,2)
        predSphere.Anchored=true predSphere.CanCollide=false
        predSphere.Material=Enum.Material.Neon predSphere.Color=Color3.fromRGB(255,50,50)
        predSphere.Transparency=0.35 predSphere.Parent=workspace
    end
    if pos then predSphere.CFrame=CFrame.new(pos) end
end

local function cleanupPredSphere()
    if predSphere then predSphere:Destroy() predSphere=nil end
end

-- ═══════════════════════════════════════════
-- IMPROVED BYPASS
-- Works for ALL weapons, not just slingshot
-- Tracks by name list + speed threshold
-- ═══════════════════════════════════════════
local bypTracked   = {}  -- [part] = true
local bypHB        = nil
local bypChildAdd  = nil
local bypChildRem  = nil

-- Check if a part name matches any known projectile
local function isKnownProjectile(name)
    for _, n in ipairs(Config.ExtraProjectileNames) do
        if name == n then return true end
    end
    return false
end

-- Check if a BasePart looks like a projectile by speed alone
local function isFastPart(part)
    return part:IsA("BasePart") and
           part.AssemblyLinearVelocity.Magnitude > Config.SpeedThreshold
end

local function bypTrack(obj)
    if not obj:IsA("BasePart") then return end
    bypTracked[obj] = true
end

local function stopBypass()
    if bypHB       then bypHB:Disconnect()       bypHB=nil       end
    if bypChildAdd then bypChildAdd:Disconnect()  bypChildAdd=nil end
    if bypChildRem then bypChildRem:Disconnect()  bypChildRem=nil end
    bypTracked          = {}
    predCache           = {}
    nearestEnemyCache   = nil
    nearestEnemyCacheTime = 0
    cleanupPredSphere()
end

local function startBypass()
    stopBypass()

    -- ── Track new workspace children ──
    bypChildAdd = workspace.ChildAdded:Connect(function(o)
        if not o:IsA("BasePart") then return end

        -- Immediately track known projectile names
        if isKnownProjectile(o.Name) then
            bypTrack(o)
            return
        end

        -- Defer check for fast-moving unnamed parts
        -- (covers bullets, pellets, any unnamed projectile)
        task.defer(function()
            if o and o.Parent then
                if isFastPart(o) then
                    bypTrack(o)
                -- Also check children added inside models/folders
                -- e.g. some weapons put projectiles inside a folder
                elseif o:IsA("Model") or o:IsA("Folder") then
                    for _, child in ipairs(o:GetDescendants()) do
                        if child:IsA("BasePart") and (isKnownProjectile(child.Name) or isFastPart(child)) then
                            bypTrack(child)
                        end
                    end
                end
            end
        end)
    end)

    -- Also scan descendants of workspace for projectiles
    -- spawned inside folders/models (some guns do this)
    workspace.DescendantAdded:Connect(function(o)
        if not o:IsA("BasePart") then return end
        if isKnownProjectile(o.Name) then
            bypTrack(o)
        end
    end)

    bypChildRem = workspace.ChildRemoved:Connect(function(o)
        bypTracked[o] = nil
        -- Also remove any descendants
        if o:IsA("Model") or o:IsA("Folder") then
            for _, child in ipairs(o:GetDescendants()) do
                bypTracked[child] = nil
            end
        end
    end)

    bypHB = RunService.Heartbeat:Connect(function()
        -- wrap in pcall so one bad frame doesn't kill the loop
        pcall(function()
            frameCount = frameCount + 1

            -- Prediction cache update (throttled)
            if Config.PredictionEnabled and frameCount % PRED_UPDATE_RATE == 0 then
                for _, p in ipairs(playerCache) do
                    local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then updatePredCacheForPlayer(p, hrp) end
                end
            end

            local nearestOnly = Config.TargetMode == "Nearest Enemy" and getNearestEnemy() or nil

            -- Prediction sphere (throttled)
            if Config.PredictionEnabled and Config.PredictionShowSphere and frameCount % 3 == 0 then
                local pt = nearestOnly
                    or (Config.TargetMode == "Specific Player" and targetPlayerObj)
                    or nearestEnemyCache
                if pt then updatePredSphere(getPredictedPosition(pt)) end
            elseif not Config.PredictionEnabled then
                cleanupPredSphere()
            end

            -- ── Teleport enemies ──
            if Config.TeleportEnemies then
                local vx,vy,vz = Config.VoidPos.X, Config.VoidPos.Y, Config.VoidPos.Z
                for _, p in ipairs(playerCache) do
                    if not shouldTargetPlayer(p) then continue end
                    local skip = false
                    if Config.TargetMode == "Nearest Enemy" then skip = p ~= nearestOnly
                    elseif Config.TargetMode == "Specific Player" then skip = p ~= targetPlayerObj end
                    if not skip and p.Character then
                        local h = p.Character:FindFirstChild("HumanoidRootPart")
                        if h then
                            if Config.PredictionEnabled then
                                local pred = getPredictedPosition(p)
                                h.CFrame = pred and CFrame.new(pred.X,vy,pred.Z) or CFrame.new(vx,vy,vz)
                            else
                                h.CFrame = CFrame.new(vx,vy,vz)
                            end
                            h.AssemblyLinearVelocity  = Vector3.zero
                            h.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                end
            end

            -- ── Void ALL tracked projectiles ──
            -- This now covers: CoreProjectile, Arrow, Bullet, Grenade,
            -- fast unnamed Parts, and anything caught by DescendantAdded
            if Config.VoidProjectiles then
                local vcf = CFrame.new(Config.VoidPos)

                -- Scan tracked table
                for part in pairs(bypTracked) do
                    if part and part.Parent then
                        part.CFrame                 = vcf
                        part.AssemblyLinearVelocity = Vector3.zero
                    else
                        bypTracked[part] = nil
                    end
                end

                -- Live scan of workspace children for anything we missed
                -- (covers weapons that spawn projectiles we haven't tracked yet)
                for _, obj in ipairs(workspace:GetChildren()) do
                    if obj:IsA("BasePart") then
                        if isKnownProjectile(obj.Name) then
                            obj.CFrame = vcf
                            obj.AssemblyLinearVelocity = Vector3.zero
                            bypTracked[obj] = true
                        elseif obj.AssemblyLinearVelocity.Magnitude > Config.SpeedThreshold then
                            obj.CFrame = vcf
                            obj.AssemblyLinearVelocity = Vector3.zero
                            bypTracked[obj] = true
                        end
                    end
                end
            end
        end)
    end)
end

-- ═══════════════════════════════════════════
-- HIT REG
-- ═══════════════════════════════════════════
local tracked    = {}
local hitTotal   = 0
local shotTotal  = 0
local hitRegConn = nil
local hrChildAdd = nil
local hrChildRem = nil

local function multiRaycast(origin,direction,strength)
    local ext=1+(strength/100)*4
    local mainDir=direction*ext
    local hit=workspace:Raycast(origin,mainDir,rParams)
    if hit then return hit end
    local spread=(strength/100)*0.6
    local perp1=Vector3.new(-direction.Z,0,direction.X).Unit*spread
    local perp2=Vector3.new(direction.Z,0,-direction.X).Unit*spread
    local up=Vector3.new(0,spread,0)
    for _,off in ipairs({perp1,perp2,up,-up}) do
        local h=workspace:Raycast(origin+off,mainDir,rParams) if h then return h end
    end
    return workspace:Raycast(origin,mainDir*2,rParams)
end

local function shouldFire()
    if Config.HitRegStrength>=100 then return true end
    if Config.HitRegStrength<=0   then return false end
    return math.random(1,100)<=Config.HitRegStrength
end

local function trackHR(obj)
    if not obj:IsA("BasePart") then return end
    tracked[obj]={lastPos=obj.Position,lastPos2=obj.Position} shotTotal=shotTotal+1
end

local function stopHitReg()
    if hitRegConn then hitRegConn:Disconnect() hitRegConn=nil end
    if hrChildAdd then hrChildAdd:Disconnect() hrChildAdd=nil end
    if hrChildRem then hrChildRem:Disconnect() hrChildRem=nil end
    tracked={}
end

local function startHitReg()
    stopHitReg()
    hrChildAdd=workspace.ChildAdded:Connect(function(o)
        if isKnownProjectile(o.Name) then trackHR(o)
        elseif o.Name=="Part" then
            task.defer(function()
                if o and o.Parent and o.AssemblyLinearVelocity.Magnitude>Config.HRSpeedThresh then trackHR(o) end
            end)
        end
    end)
    hrChildRem=workspace.ChildRemoved:Connect(function(o) tracked[o]=nil end)
    hitRegConn=RunService.Heartbeat:Connect(function()
        if Config.FreezeEnemies then
            for _,p in ipairs(playerCache) do
                local hrp=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then hrp.CFrame=Void hrp.AssemblyLinearVelocity=Vector3.zero hrp.AssemblyAngularVelocity=Vector3.zero end
            end
        end
        for obj,data in pairs(tracked) do
            if obj and obj.Parent then
                local cur=obj.Position local dir=cur-data.lastPos
                if dir.Magnitude>0.01 and shouldFire() then
                    local hit=multiRaycast(data.lastPos,dir,Config.HitRegStrength)
                    if hit then
                        hitTotal=hitTotal+1
                        if Config.ShowDebug then print(string.format("[HitReg] Hit: %s | %d/%d (%.0f%%)",hit.Instance.Name,hitTotal,shotTotal,shotTotal>0 and hitTotal/shotTotal*100 or 0)) end
                    end
                end
                if (cur-data.lastPos2).Magnitude>0.01 and shouldFire() then multiRaycast(data.lastPos2,cur-data.lastPos2,Config.HitRegStrength) end
                data.lastPos2=data.lastPos data.lastPos=cur
                if Config.VoidHitProj then obj.CFrame=Void obj.AssemblyLinearVelocity=Vector3.zero end
            else tracked[obj]=nil end
        end
    end)
end

-- ═══════════════════════════════════════════
-- WEAPONS
-- ═══════════════════════════════════════════
local WeaponDefaults={Slingshot={ReloadLength=0},Bow={ReloadLength=0},Daggers={ReloadLength=0.09},Gunblade={ReloadLength=0}}
local function getItems()
    local ok,IL=pcall(function() return require(ReplicatedStorage.Modules.ItemLibrary) end)
    if not ok then return nil end return rawget(IL,"Items")
end
local function applyWeaponBypass(name,enabled,speed)
    local Items=getItems() if not Items then return end
    for _,Item in Items do
        if Item.Name==name then
            if Item["ReloadLength"]==nil then continue end
            if enabled then
                local base=WeaponDefaults[name] and WeaponDefaults[name].ReloadLength or 0
                local mult=(300-speed)/200 local nv=math.clamp(base*mult,0,base*3)
                if speed>=300 then nv=(name=="Daggers") and 0.001 or 0 end
                rawset(Item,"ReloadLength",nv)
            else rawset(Item,"ReloadLength",WeaponDefaults[name] and WeaponDefaults[name].ReloadLength or 0) end
        end
    end
end
local function applyAllWeapons()
    if Config.SlingshotEnabled then applyWeaponBypass("Slingshot",true,Config.SlingshotSpeed) end
    if Config.BowEnabled       then applyWeaponBypass("Bow",true,Config.WeaponSpeed)          end
    if Config.DaggersEnabled   then applyWeaponBypass("Daggers",true,Config.WeaponSpeed)      end
    if Config.GunbladeEnabled  then applyWeaponBypass("Gunblade",true,Config.WeaponSpeed)     end
end
local function resetAllWeapons()
    for name in pairs(WeaponDefaults) do applyWeaponBypass(name,false,100) end
end

